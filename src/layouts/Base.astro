---
import "@fontsource-variable/inter";
import "@fontsource/barlow-condensed/600.css";
import "@fontsource/barlow-condensed/700.css";
import "../styles/global.css";
import { site } from "../data/site";
import { faqs } from "../data/content";

interface Props {
  title?: string;
  description?: string;
}
const { title = site.title, description = site.description } = Astro.props;
// Dominio público según astro.config.mjs (SITE_URL o el de Vercel), para que la imagen al compartir siempre cargue.
const origin = (Astro.site ?? new URL(site.url)).origin;
// Con build.format "file" la portada se genera como /index.html; la URL pública es /.
const path = Astro.url.pathname.replace(/(index)?\.html$/, "").replace(/\/$/, "") || "/";
const canonical = new URL(path, origin).href;
const ogImage = new URL("/og.jpg", origin).href;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ProfessionalService",
      "@id": `${origin}/#negocio`,
      name: site.legalName,
      description,
      url: origin,
      image: ogImage,
      logo: new URL("/favicon.png", origin).href,
      telephone: site.phone,
      email: site.email,
      address: {
        "@type": "PostalAddress",
        streetAddress: site.address.street,
        addressLocality: site.address.city,
        addressRegion: site.address.region,
        addressCountry: site.address.country,
      },
      areaServed: { "@type": "AdministrativeArea", name: "Región de Valparaíso" },
      sameAs: [site.instagram],
      contactPoint: {
        "@type": "ContactPoint",
        telephone: site.whatsapp,
        contactType: "customer service",
        availableLanguage: "es",
      },
    },
    {
      "@type": "WebPage",
      "@id": `${canonical}#pagina`,
      url: canonical,
      name: title,
      description,
      inLanguage: "es-CL",
      about: { "@id": `${origin}/#negocio` },
    },
    {
      "@type": "FAQPage",
      mainEntity: faqs.map((f) => ({
        "@type": "Question",
        name: f.q,
        acceptedAnswer: { "@type": "Answer", text: f.a },
      })),
    },
  ],
};
---

<!doctype html>
<html lang="es-CL" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#7a1c24" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CL" />
    <meta property="og:site_name" content={site.legalName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="GAUZA Arquitectura y Construcción: tu proyecto, del plano a la recepción final" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a
      href="#contenido"
      class="sr-only z-[60] rounded-full bg-wine-700 px-5 py-3 text-sm font-semibold text-white focus:not-sr-only focus:fixed focus:top-4 focus:left-4"
      >Saltar al contenido</a
    >
    <slot />
    <script>
      import "../scripts/main.ts";
    </script>
  </body>
</html>
