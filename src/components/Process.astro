---
import { steps } from "../data/content";
---

<section id="proceso" class="section">
  <div class="container-site">
    <div class="max-w-3xl" data-reveal>
      <p class="eyebrow">Cómo trabajamos</p>
      <h2 class="section-title mt-4">Cuatro pasos, un solo equipo de principio a fin</h2>
      <p class="section-lead">
        Sabes en qué etapa va tu proyecto y qué viene después. Nosotros nos ocupamos de la parte técnica y de los
        trámites.
      </p>
    </div>

    <ol class="steps mt-14 grid gap-5 md:grid-cols-2 lg:grid-cols-4">
      {
        steps.map((s, i) => (
          <li class="step relative" data-reveal data-i={i}>
            <div class="flex items-center gap-4">
              <span class="step-num grid size-14 shrink-0 place-content-center rounded-full border border-wine-700/25 bg-white font-display text-2xl font-bold text-wine-700">
                {i + 1}
              </span>
              <span class="step-line hidden h-px flex-1 bg-line lg:block" aria-hidden="true" />
            </div>
            <h3 class="mt-6 text-2xl leading-none">{s.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-ink-500">{s.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .step:last-child .step-line {
    display: none;
  }
  .step-num {
    transition: background-color 0.35s, color 0.35s, transform 0.35s var(--ease-out-soft);
  }
  .step:hover .step-num {
    background: var(--color-wine-700);
    color: #fff;
    transform: scale(1.06);
  }
</style>
