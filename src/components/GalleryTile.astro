---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  title: string;
  meta: string;
  class?: string;
  index?: number;
}
const { src, alt, title, meta, class: className = "", index = 0 } = Astro.props;
---

<li class={`group relative overflow-hidden rounded-[1.25rem] bg-sand ${className}`} data-reveal data-i={index}>
  <Image
    src={src}
    alt={alt}
    widths={[300, 560]}
    sizes="(min-width: 1024px) 24rem, 50vw"
    class="size-full object-cover transition-transform duration-[900ms] ease-[var(--ease-out-soft)] group-hover:scale-[1.06]"
  />
  <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-ink-950/80 via-ink-950/30 to-transparent p-4 pt-12 text-white sm:p-5 sm:pt-14">
    <p class="font-display text-lg leading-none font-semibold tracking-wide uppercase sm:text-xl">{title}</p>
    <p class="mt-1 text-xs text-white/75">{meta}</p>
  </div>
</li>
