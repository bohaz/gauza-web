---
import BeforeAfter from "./BeforeAfter.astro";
import Icon from "./Icon.astro";
import { projects } from "../data/content";
import { wa } from "../data/site";
---

<section id="proyectos" class="section relative overflow-hidden bg-ink-950 text-white">
  <svg
    class="pointer-events-none absolute -right-24 -bottom-24 w-[34rem] text-white/[0.04]"
    viewBox="0 0 100 90"
    fill="none"
    stroke="currentColor"
    stroke-width="0.5"
    aria-hidden="true"
  >
    <path d="M50 2 98 88H2z" /><path d="M50 18 84 80H16z" /><path d="M50 34 70 72H30z" />
  </svg>

  <div class="container-site relative">
    <div class="grid gap-6 lg:grid-cols-[1fr_1fr] lg:items-end">
      <div data-reveal>
        <p class="eyebrow !text-wine-100 before:!border-b-wine-100">Proyectos</p>
        <h2 class="section-title mt-4 !text-white">Así lo diseñamos, así se construyó</h2>
      </div>
      <p class="section-lead !text-ink-300 lg:justify-self-end" data-reveal>
        Desliza sobre cada imagen para comparar la propuesta con la obra real. Viviendas, ampliaciones y locales en
        distintas comunas de la región.
      </p>
    </div>

    <div class="mt-12 grid gap-6 lg:mt-14 lg:grid-cols-[minmax(0,1.7fr)_minmax(0,1fr)] lg:gap-8" data-tabs data-reveal>
      <!-- Lista de proyectos: columna en escritorio, carrusel horizontal en celular -->
      <div
        role="tablist"
        aria-label="Proyectos"
        class="tablist -mx-5 flex snap-x scroll-px-5 gap-2 overflow-x-auto px-5 pb-1 lg:order-2 lg:mx-0 lg:flex-col lg:gap-0 lg:overflow-visible lg:px-0"
      >
        {
          projects.map((p, i) => (
            <button
              type="button"
              role="tab"
              id={`tab-${p.id}`}
              aria-selected={i === 0 ? "true" : "false"}
              aria-controls={`panel-${p.id}`}
              tabindex={i === 0 ? 0 : -1}
              class="tab group snap-start"
              data-tab
            >
              <span class="tab-index font-display text-sm text-ink-500">{String(i + 1).padStart(2, "0")}</span>
              <span class="min-w-0 text-left">
                <span class="tab-name block font-display text-xl leading-none font-semibold tracking-wide uppercase">{p.name}</span>
                <span class="tab-meta mt-1 hidden text-xs text-ink-300 lg:block">
                  {p.type} · {p.place}
                </span>
              </span>
              <Icon name="arrow" class="tab-arrow ml-auto hidden size-5 lg:block" />
            </button>
          ))
        }
      </div>

      <div class="lg:order-1">
        {
          projects.map((p, i) => (
            <article
              id={`panel-${p.id}`}
              role="tabpanel"
              aria-labelledby={`tab-${p.id}`}
              class="panel"
              hidden={i !== 0}
              data-panel
            >
              <BeforeAfter project={p} eager={i === 0} />
              <div class="mt-6 grid gap-5 sm:grid-cols-[1fr_auto] sm:items-start">
                <div>
                  <p class="text-xs font-semibold tracking-[0.16em] text-wine-100 uppercase">
                    {p.type} · {p.place}
                  </p>
                  <h3 class="mt-2 text-3xl leading-none !text-white">{p.name}</h3>
                  <p class="mt-3 max-w-[52ch] text-sm leading-relaxed text-ink-300">{p.summary}</p>
                </div>
                <ul class="flex flex-wrap gap-2 sm:max-w-[16rem] sm:justify-end">
                  {p.facts.map((f) => (
                    <li class="rounded-full border border-white/15 px-3 py-1.5 text-xs text-white/85">{f}</li>
                  ))}
                </ul>
              </div>
            </article>
          ))
        }
      </div>
    </div>

    <div class="mt-14 flex flex-col items-start justify-between gap-5 border-t border-white/10 pt-8 sm:flex-row sm:items-center" data-reveal>
      <p class="max-w-[46ch] text-ink-300">¿Tienes un proyecto parecido? Cuéntanos qué quieres hacer y te orientamos.</p>
      <a class="btn btn-light" href={wa("Hola GAUZA, vi sus proyectos y quiero cotizar el mío.")} target="_blank" rel="noopener">
        <Icon name="whatsapp" class="size-5" /> Hablemos de tu proyecto
      </a>
    </div>
  </div>
</section>

<style>
  .tablist {
    scrollbar-width: none;
  }
  .tablist::-webkit-scrollbar {
    display: none;
  }
  .tab {
    display: flex;
    flex: none;
    align-items: center;
    gap: 0.75rem;
    min-height: 2.75rem;
    padding: 0.6rem 1rem;
    border: 1px solid rgb(255 255 255 / 0.14);
    border-radius: 999px;
    color: rgb(255 255 255 / 0.7);
    cursor: pointer;
    transition: color 0.3s, background-color 0.3s, border-color 0.3s;
  }
  .tab:hover {
    color: #fff;
    border-color: rgb(255 255 255 / 0.35);
  }
  .tab[aria-selected="true"] {
    background: var(--color-wine-700);
    border-color: var(--color-wine-700);
    color: #fff;
  }
  .tab[aria-selected="true"] .tab-index {
    color: var(--color-wine-100);
  }
  .tab-name {
    white-space: nowrap;
  }
  .tab-arrow {
    opacity: 0;
    transform: translateX(-6px);
    transition: opacity 0.3s, transform 0.35s var(--ease-out-soft);
  }

  @media (min-width: 1024px) {
    .tab {
      width: 100%;
      gap: 1.25rem;
      padding: 1.15rem 0.25rem 1.15rem 0;
      border: 0;
      border-bottom: 1px solid rgb(255 255 255 / 0.1);
      border-radius: 0;
      background: none !important;
    }
    .tab:first-child {
      border-top: 1px solid rgb(255 255 255 / 0.1);
    }
    .tab-name {
      font-size: 1.5rem;
      white-space: normal;
      transition: transform 0.35s var(--ease-out-soft);
    }
    .tab:hover .tab-name {
      transform: translateX(4px);
    }
    .tab[aria-selected="true"] .tab-name {
      color: #fff;
      transform: translateX(8px);
    }
    .tab[aria-selected="true"] .tab-index {
      color: var(--color-wine-100);
    }
    .tab[aria-selected="true"] .tab-arrow,
    .tab:hover .tab-arrow {
      opacity: 1;
      transform: none;
    }
    .tab[aria-selected="true"] .tab-arrow {
      color: var(--color-wine-100);
    }
  }

  .panel:not([hidden]) {
    animation: panel-in 0.55s var(--ease-out-soft);
  }
  @keyframes panel-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>
